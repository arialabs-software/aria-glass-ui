{
  "name": "aria-glass-ui",
  "version": "0.1.0",
  "description": "Liquid Glass UI primitives for React with a single, centralized config: real edge refraction (LiquidLens) and iOS-style press and flex gestures (Motion).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arialabs-software/aria-glass-ui.git"
  },
  "homepage": "https://github.com/arialabs-software/aria-glass-ui#readme",
  "bugs": {
    "url": "https://github.com/arialabs-software/aria-glass-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/engine/liquid-glass.js",
    "./dist/engine/engine.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "react",
    "liquid-glass",
    "glass",
    "ui",
    "primitives",
    "nextjs",
    "motion"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "motion": "^13.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "motion": "13.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
